//- @title: Главная — Центр Профессиональной Подготовки
//- @description: Центр Профессиональной Подготовки — обучение, лицензии, оружие
//- @page_class: index
extends ../layouts/default.pug

block content
  //- Главный экран по макету 313-272: фон, подзаголовок, заголовок, два абзаца, кнопка. Высота секции = 100vh.
  section.section.section--intro
    .intro
      .intro_bg
        .intro_bg_image
        .intro_overlay
      +Container()
        .intro_content
          p.intro_label Центр Профессиональной Подготовки и обучения
          h1.intro_title Обучение стрельбе, получение лицензии, разрешение на оружие
          .intro_text
            p Частное образовательное учреждение дополнительного профессионального образования «Центр Профессиональной Подготовки», входящее в состав объединения "Глобал-Безопасность", было основано в 1998 году в г. Мытищи.
            p В соответствии с полученной лицензией на образовательную деятельность учебный центр осуществляет обучение и повышение квалификации лиц, работающих в сфере частной охраны.
          .intro_actions
            +Button('Наши курсы', 'primary', 'lg')(href='#courses')

  //- Курсы (по макету 313-288, переиспользуемая секция)
  - var coursesList = [{ icon: 'course-icon-1', title: 'Обучение охранников, подготовка по программе ГБР, инкасации, личной охраны', text: 'Для того что бы стать охранником (получить лицензию охранника) необходимо пройти обучение на охранника 4, 5 или 6 разряда по программе обучения частных охранников в специальном образовательном учреждении', link: '#' }, { icon: 'course-icon-2', title: 'Курсы охранника-инкассатора', text: 'Курс направлен на приобретение теоретических знаний и получение практических навыков по инкассации и перевозке ценностей, а также умение правильно действовать при возникновении опасной ситуации.', link: '#' }, { icon: 'course-icon-3', title: 'Повышение квалификации руководителей', text: 'Программы повышения квалификации позволят в сжатые сроки и с минимальными затратами получить новые знания и навыки, необходимые для Вашего карьерного развития.', link: '#' }, { icon: 'course-icon-4', title: 'Повышение квалификации охраников', text: 'Повышение квалификации частных охранников. Эффективная работа службы безопасности невозможна без постоянного профессионального роста кадров.', link: '#' }, { icon: 'course-icon-5', title: 'Квалификационный экзамен и периодическая проверка', text: 'Вопросы для билетов позаимствованы с официального сайта Росгвардии. В билетах использованы все вопросы для успешной сдачи экзамена.', link: '#' }, { icon: 'course-icon-6', title: 'Получение лицензии на оружие', text: 'Помощь в официальном восстановлении, получении и продлении лицензии на оружие.', link: '#' }, { icon: 'course-icon-7', title: 'Предоставление учебно-методической базы', text: 'Оказание услуг по предоставлению учебно-методической и материальной базы для организации совместной образовательной деятельности.', link: '#' }, { icon: 'course-icon-8', title: 'Вопросы и ответы для подготовки к сдаче квалификационного экзамена', text: 'Курс направлен на приобретение теоретических знаний и получение практических навыков для успешной сдачи квалификационного экзамена.', link: '#' }, { icon: 'course-icon-9', title: 'Обучение стрельбе из огнестрельного оружия', text: 'Программы повышения квалификации позволят в сжатые сроки и с минимальными затратами получить новые знания и навыки по стрельбе.', link: '#' }]
  +CoursesSection('courses', 'Курсы', 'Услуги которые мы оказываем', coursesList)

  //- О нас (миксин: контент full, кнопка secondary)
  +AboutSection('about', 'О нас', 'full', '#', 'secondary')

  //- Преподавательский состав (по макету 313-448, переиспользуемая секция)
  - var teachersList = [{ img: 'teacher-1', name: 'Королев Михаил Иванович', role: 'Председатель правления', extra: 'Объединения "Глобал Безопасность"' }, { img: 'teacher-2', name: 'Гончаров Александр Михайлович', role: 'Директор', extra: 'ЧОУ ДПО "ЦПП"' }, { img: 'teacher-3', name: 'Световеч Иван Иванович', role: 'Старший преподаватель', extra: 'Телефон: 8(495) 582-42-91' }, { img: 'teacher-4', name: 'Шулаев Роман Михайлович', role: 'Старший преподаватель', extra: 'Телефон: 8(495) 582-42-91' }]
  +TeachersSection('teachers', 'Преподавательский состав', 'Услуги которые мы оказываем', teachersList)

  //- Образование (миксин: контент full)
  +EducationSection('education', 'Образование', 'full')

  //- CTA (по макету 313-487, переиспользуемая секция)
  +CtaSection('cta')

  //- Приказы (по макету 313-508, переиспользуемая секция)
  - var ordersList = [{ title: 'Приказ 541-20/542-20/543-20', desc: 'О выпуске слушателей, прошедших обучение по программе «Подготовки частных охранников».', link: '#' }, { title: 'Приказ 541-20/542-20/543-20', desc: 'О выпуске слушателей, прошедших обучение по программе «Подготовки частных охранников».', link: '#' }, { title: 'Приказ 541-20/542-20/543-20', desc: 'О выпуске слушателей, прошедших обучение по программе «Подготовки частных охранников».', link: '#' }]
  +OrdersSection('orders', 'Приказы', ordersList, 'Скачать', 'download')

  //- Публикации (миксин)
  - var blogList = [{ img: 'post-1', date: '21 декабря 2025', title: 'Центру Профессиональной Подготовки Объединения «Глобал-Безопасность» вручена грамота', desc: 'К своему 20-му юбилею ЦПП подошёл, имея репутацию высокопрофессионального и достойного партнёра.', link: '#' }, { img: 'post-2', date: '20 декабря 2025', title: 'Повышение квалификации руководящего состава среднего звена', desc: 'К своему 20-му юбилею ЦПП подошёл, имея репутацию высокопрофессионального и достойного партнёра.', link: '#' }, { img: 'post-3', date: '19 декабря 2025', title: 'Повышение квалификации руководящего состава среднего звена', desc: 'К своему 20-му юбилею ЦПП подошёл, имея репутацию высокопрофессионального и достойного партнёра.', link: '#' }, { img: 'post-1', date: '21 декабря 2025', title: 'Центру Профессиональной Подготовки Объединения «Глобал-Безопасность» вручена грамота', desc: 'К своему 20-му юбилею ЦПП подошёл, имея репутацию высокопрофессионального и достойного партнёра.', link: '#' },]
  +BlogSection('blog', 'Публикации', 'Новости и статьи', blogList, 'Все публикации', '#blog', undefined, 'arrows')

  //- Вакансии (по макету 313-609)
  section.section.section--vacancies#vacancies
    +Container('vacancies')
      .vacancies.section_content
        +SectionHeader('Вакансии', 'Приглашаем на работу')
        .vacancies_grid.vacancies_grid--swiper
          - var vacList = [{ icon: 'vacancy-card-icon-1', title: 'Водитель-охранник', desc: 'Приглашаем водителей-охранников', pay: '2000', link: '#' }, { icon: 'vacancy-card-icon-2', title: 'Охранник 4-го разряда', desc: 'Приглашаем на работу охранников 4-го разряда', pay: '1600', link: '#' }, { icon: 'vacancy-card-icon-3', title: 'Охранник 6-го разряда', desc: 'Приглашаем на работу охранников 6-го разряда', pay: '2000', link: '#' }]
          - var vacBullets = ['Вахта 15/15', 'Расчет - после вахты', 'Проживание в комфортабельном общежитии', 'Возможность подработки']
          each v in vacList
            .vacancies_card
              .vacancies_card_icon
                img(src="assets/img/" + v.icon + ".svg", alt="", width="48", height="48")
              .vacancies_card_head
                h3.vacancies_card_title= v.title
                p.vacancies_card_desc= v.desc
              .vacancies_card_body
                ul.vacancies_card_list
                  li.vacancies_card_list_item Оплата #{v.pay} Р за сутки
                  each bullet in vacBullets
                    li.vacancies_card_list_item= bullet
                +Button('Откликнуться', 'outline', 'sm')(href=v.link)

  //- SEO-текст ЦПП (одинаковый контент — секция через include)
  include ../components/sections/seo-text.pug

  //- Наши партнёры: лента с дублированием трека (JS в main.js — .partners_line / .partners_track)
  section.section.section--partners
    +Container()
      .partners.section_content
        +SectionHeader('Наши партнеры', 'Нам доверяют')
        .partners_line(aria-label='Логотипы партнёров')
          .partners_line-inner
            .partners_track
              - var partList = ['partners-card-icon-1', 'partners-card-icon-2', 'partners-card-icon-3', 'partners-card-icon-4', 'partners-card-icon-5']
              each p in partList
                .partners_card
                  img(src="assets/img/" + p + ".svg", alt="", loading="lazy")
