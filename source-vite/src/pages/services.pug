//- @title: Наши услуги — Центр Профессиональной Подготовки
//- @description: Услуги ЦПП: обучение охранников, курсы инкассаторов, повышение квалификации, лицензия на оружие.
//- @page_class: services
extends ../layouts/default.pug

block content
  +PageIntro({
    title: 'Наши услуги',
    breadcrumbs: [{ text: 'Главная', href: 'index.html' }, { text: 'Наши услуги'}],
    altType: true
  })
  
  section.section.section--courses
    +Container('courses')
      .courses_grid.courses_grid--courses
        - var servicesList = [{ icon: 'course-icon-1', title: 'Обучение охранников, подготовка по программе ГБР, инкасации, личной охраны', text: 'Для того что бы стать охранником (получить лицензию охранника) необходимо пройти обучение на охранника 4, 5 или 6 разряда по программе обучения частных охранников в специальном образовательном учреждении', link: '#' }, { icon: 'course-icon-2', title: 'Курсы охранника-инкассатора', text: 'Курс направлен на приобретение теоретических знаний и получение практических навыков по инкассации и перевозке ценностей, а также умение правильно действовать при возникновении опасной ситуации.', link: '#' }, { icon: 'course-icon-3', title: 'Повышение квалификации руководителей', text: 'Программы повышения квалификации позволят в сжатые сроки и с минимальными затратами получить новые знания и навыки, необходимые для Вашего карьерного развития.', link: '#' }, { icon: 'course-icon-4', title: 'Повышение квалификации охранников', text: 'Повышение квалификации частных охранников. Эффективная работа службы безопасности невозможна без постоянного профессионального роста кадров.', link: '#' }, { icon: 'course-icon-5', title: 'Квалификационный экзамен и периодическая проверка', text: 'Вопросы для билетов позаимствованы с официального сайта Росгвардии. В билетах использованы все вопросы для успешной сдачи экзамена.', link: '#' }, { icon: 'course-icon-6', title: 'Получение лицензии на оружие', text: 'Помощь в официальном восстановлении, получении и продлении лицензии на оружие.', link: '#' }]
        each item in servicesList
          +CourseCard(item)

  //- CTA «Написать нам» (переиспользуемый миксин)
  +CtaSection('cta')

  //- О нас (миксин: контент full, кнопка outline)
  +AboutSection('about', 'О нас', 'full', '#')

  //- Преподавательский состав (переиспользуемый миксин)
  - var teachersList = [{ img: 'teacher-1', name: 'Королев Михаил Иванович', role: 'Председатель правления', extra: 'Объединения "Глобал Безопасность"' }, { img: 'teacher-2', name: 'Гончаров Александр Михайлович', role: 'Директор', extra: 'ЧОУ ДПО "ЦПП"' }, { img: 'teacher-3', name: 'Световеч Иван Иванович', role: 'Старший преподаватель', extra: 'Телефон: 8(495) 582-42-91' }, { img: 'teacher-4', name: 'Шулаев Роман Михайлович', role: 'Старший преподаватель', extra: 'Телефон: 8(495) 582-42-91' }]
  +TeachersSection('teachers', 'Преподавательский состав', 'Услуги которые мы оказываем', teachersList)

  //- SEO-текст ЦПП (одинаковый контент — секция через include)
  include ../components/sections/seo-text.pug
