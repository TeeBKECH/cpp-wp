//- @title: Статья детальная
//- @description: Статья детальная описание
//- @page_class: article
extends ../layouts/default.pug

block content
  +PageIntro({
    title: 'Обучение охранников 4, 5 и 6 разрядов',
    desc: 'ЧОУ ДПО «Центр профессиональной подготовки» проводит обучение частных охранников 4-го, 5-го и 6-го разрядов в соответствии с приказом ФСВНГ РФ № 396 от 30 ноября 2019 года и требованиями законодательства Российской Федерации. Программа разработана и утверждена в Росгвардии, что гарантирует её соответствие профессиональным стандартам.',
    breadcrumbs: [{ text: 'Главная', href: 'index.html' }, { text: 'Статьи', href: 'articles.html' }, { text: 'Обучение охранников 4, 5 и 6 разрядов', href: '#' }],
    date: '21 марта 2024',
    views: 1231
  })

  //- Контент: две колонки (основной текст + сайдбар «Содержание»)
  section.section.section--page-content
    +Container()
      .page-content.page-content--article
        .page-content_main
          .page-content_section
            +SectionHeader('Цель курса')
            p Подготовка частных охранников к выполнению трудовых функций в соответствии с требованиями профессионального стандарта. Формирование знаний в области правового регулирования охранной деятельности, правил применения специальных средств и огнестрельного оружия, первой помощи и психологической подготовки.
          .page-content_section
            +SectionHeader('Категории подготовки')
            ul
              li Правовая подготовка
              li Тактико-специальная подготовка
              li Использование специальных средств
              li Огневая подготовка (для 6 разряда)
              li Первая помощь
              li Психологическая подготовка
          .page-content_section
            +SectionHeader('Практическая направленность')
            p Занятия включают отработку практических навыков: применение специальных средств, действия в экстремальных ситуациях, оказание первой помощи. Для охранников 6 разряда предусмотрена стрелковая подготовка.
          .page-content_section
            +SectionHeader('Квалификационные требования')
            p К обучению допускаются граждане РФ не моложе 18 лет, годные по состоянию здоровья к исполнению обязанностей частного охранника, прошедшие профессиональный отбор.
          .page-content_gallery
            +GalleryService({
              items: [
                { img: 'assets/img/sevice-preview.jpg', alt: 'Услуга детальная' },
                { img: 'assets/img/sevice-preview.jpg', alt: 'Услуга детальная' },
              ]
            })
          .page-content_section
            +SectionHeader('Документы для поступления')
            ul
              li Паспорт гражданина РФ
              li Медицинская справка по форме 002-О/у
              li Фотографии 3×4 см
              li Заявление и договор
          .page-content_section
            +SectionHeader('Сроки обучения')
            p Продолжительность программы: 30 часов (переподготовка), 80 часов (5 разряд), 160 часов (6 разряд). Возможны различные форматы занятий в зависимости от набора группы.
          .page-content_section.page-content_section--certificate
            +SectionHeader('Получите профессию охранника с правом ношения оружия')
            .page-content_certificate
              .page-content_certificate-text
                p По окончании обучения и успешной сдаче квалификационного экзамена выдаётся удостоверение частного охранника установленного образца с правом применения огнестрельного оружия и специальных средств (для 6 разряда).
              .page-content_certificate-options
                +Button('Программа 4,5,6 разряд - РосГвардия', 'icon', 'sm')(icon='download')
                +Button('Программа повышения квалификации 4,5,6 разряд - РосГвардия', 'icon', 'sm')(icon='download')
                +Button('Программа с 4 на 5,6 разряд - РосГвардия', 'icon', 'sm')(icon='download')
            .page-content_certificate-img(data-fancybox="preview", data-src="assets/img/education2.png")
              img(src="assets/img/education2.png", alt="Удостоверение частного охранника", loading="lazy")
            
          .page-content_section
            +SectionHeader('Расписание занятий')
            .page-content_schedule
              +Button('Расписание на Февраль', 'icon', 'sm')(icon='download')
              +Button('Расписание занятий на 30 дней', 'icon', 'sm')(icon='download')
              +Button('Подробное расписание на 90 дней', 'icon', 'sm')(icon='download')
        .page-content_sidebar
          .widget
            .widget_title Содержание:
            ul#toc-list.toc-list

  +CtaSection('cta')

  //- FAQ (миксин аккордиона)
  section.section.section--faq
    +Container()
      .faq.section_content
        +SectionHeader('Часто задаваемые вопросы', 'Самые популярные вопросы от наших клиентов')
        .faq_list
          +AccordionItem({ title: 'Какие сроки определения образовательной программы?', open: true })
            p Сроки зависят от выбранной программы: от 30 до 160 часов. Точные даты набора уточняйте у менеджера.
          +AccordionItem({ title: 'Дополнительно обучение по каким программам?' })
            p Мы проводим обучение по программам переподготовки, повышения квалификации, подготовки охранников 4, 5 и 6 разряда, инкассаторов и другим направлениям.
          +AccordionItem({ title: 'Какие квалификационные требования для зачисления на обучение?' })
            p К обучению допускаются граждане РФ не моложе 18 лет, годные по состоянию здоровья. Требуется паспорт и медицинская справка по форме 002-О/у.
          +AccordionItem({ title: 'При прохождении каких документов?' })
            p Для поступления необходимы паспорт, медицинская справка 002-О/у, фотографии 3×4 см, заявление и договор.

  //- Другие публикации (миксин BlogSection, свайпер .blog_grid--swiper)
  - var relatedList = [{ img: 'post-1', date: '7 июня 2024', title: 'Центр профессиональной подготовки «Альфа-БРО»', desc: 'К своему 20-му юбилею ЦПП подошёл, имея репутацию высокопрофессионального и достойного партнёра.', link: 'article.html' }, { img: 'post-2', date: '20 декабря 2025', title: 'Повышение квалификации руководящего состава', desc: 'К своему 20-му юбилею ЦПП подошёл, имея репутацию высокопрофессионального и достойного партнёра.', link: 'article.html' }, { img: 'post-3', date: '19 декабря 2025', title: 'Новые программы для охранников 6 разряда', desc: 'К своему 20-му юбилею ЦПП подошёл, имея репутацию высокопрофессионального и достойного партнёра.', link: 'article.html' }, { img: 'post-1', date: '15 ноября 2025', title: 'Обучение инкассаторов: требования и программы', desc: 'Актуальные программы подготовки охранников-инкассаторов и порядок аттестации в Росгвардии.', link: 'article.html' }, { img: 'post-2', date: '1 октября 2025', title: 'Изменения в порядке проверки знаний охранников', desc: 'Разъяснения по периодической проверке и квалификационному экзамену в 2025 году.', link: 'article.html' }, { img: 'post-3', date: '12 сентября 2025', title: 'Лицензия на оружие: сроки и документы', desc: 'Пошаговая инструкция по получению и продлению лицензии на оружие для охранников.', link: 'article.html' }]
  +BlogSection('related', 'Другие публикации', 'Новостная лента', relatedList, 'Все новости', 'articles.html', 'Подробнее', 'arrows')

  //- О нас (миксин: контент short, ссылка на главную)
  +AboutSection('about', 'О нас', 'full', 'index.html#about')

  //- Преподавательский состав
  - var teachersList = [{ img: 'teacher-1', name: 'Погорелов Михаил Иванович', role: 'Руководитель центра', extra: '' }, { img: 'teacher-2', name: 'Гончаров Александр Михайлович', role: 'Директор', extra: 'ЧОУ ДПО "ЦПП"' }, { img: 'teacher-3', name: 'Световеч Иван Иванович', role: 'Старший преподаватель', extra: '' }, { img: 'teacher-4', name: 'Шулаев Роман Михайлович', role: 'Старший преподаватель', extra: '' }]
  +TeachersSection('teachers', 'Преподавательский состав', 'Сотрудники, которые Вас будут обучать', teachersList)

  //- Образование (миксин: контент short)
  +EducationSection('education', 'Образование', 'full')
