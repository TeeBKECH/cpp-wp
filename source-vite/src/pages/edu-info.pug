extends ../layouts/default.pug

block content
  +PageIntro({
    title: 'Сведения об образовательной организации',
    desc: 'ЧОУ ДПО «Центр профессиональной подготовки» проводит обучение частных охранников 4-го, 5-го и 6-го разрядов в соответствии с приказом ФСВНГ РФ № 396 от 30 ноября 2019 года и требованиями законодательства Российской Федерации. Программа разработана и утверждена в Росгвардии, что гарантирует её соответствие профессиональным стандартам.',
    breadcrumbs: [{ text: 'Главная', href: 'index.html' }, { text: 'Сведения об образовательной организации'}],
    tabs: true
  })

  - var ordersList = [{ title: 'Приказ 541-20/542-20/543-20', desc: 'О выпуске слушателей, прошедших обучение по программе «Подготовки частных охранников».', link: '#' }, { title: 'Приказ 541-20/542-20/543-20', desc: 'О выпуске слушателей, прошедших обучение по программе «Подготовки частных охранников».', link: '#' }, { title: 'Приказ 541-20/542-20/543-20', desc: 'О выпуске слушателей, прошедших обучение по программе «Подготовки частных охранников».', link: '#' }]
  +OrdersSection('orders', 'Приказы', ordersList, 'Скачать', 'download')

  - var accessList = [{ title: 'Доступная среда', desc: 'Информация о доступности объекта для инвалидов и лиц с ограниченными возможностями здоровья.', link: '#' }]
  +OrdersSection('access', 'Доступная среда', accessList, 'Перейти')

  - var licenseItems = [{ img: 'education', alt: 'Лицензия 1', href: '#' }, { img: 'education', alt: 'Лицензия 2', href: '#' }, { img: 'education', alt: 'Лицензия 3', href: '#' }, { img: 'education', alt: 'Лицензия 4', href: '#' }, { img: 'education', alt: 'Лицензия 5', href: '#' }, { img: 'education', alt: 'Лицензия 6', href: '#' }]
  +OrdersSection('licenses', 'Лицензии', licenseItems, undefined, undefined, 'photos')
