doctype html
html(lang="ru")
  // page — объект из templateParameters (см. vite.config.js)
  +Head(page)

  body.body

    // Modal Mobile Menu
    +Modal('mobile-menu')(class='modal--mobile')
      +NavMobile()

    // Modal Big Menu
    +Modal('big-menu')(class='modal--menu')
      +Menu()

    // Bottom Nav
    +NavBottom({items: [
      {icon: 'home', text: 'Главная', active: true},
      {icon: 'notice', text: 'О нас'},
      {icon: 'services', text: 'Услуги'},
      {icon: 'docs', text: 'Документы'},
      {icon: 'support', text: 'Контакты'},
    ]})

    // Scroll to top — показывается при скролле вниз (JS: attachScrollVisibility + invert)
    button.scroll-to-top.hidden-by-scroll(type='button' aria-label='Наверх')
      span.scroll-to-top_icon(aria-hidden='true')

    .page(class=`${page.page_class ? 'page--' + page.page_class : ''}`)
      include ../components/sections/header.pug
      main.main(class=`${page.page_class ? 'main--' + page.page_class : ''}`)
        block content
      include ../components/sections/footer.pug