//- Секция «О нас» — переиспользуемая, контент разный (full/short). +AboutSection(sectionId?, title?, variant?, buttonHref?, buttonType?)
//- variant: 'full' | 'short', buttonType: 'secondary' | 'outline'
//- Container, Button подключаются в layout
mixin AboutSection(sectionId, title, variant, buttonHref, buttonType)
  - sectionId = sectionId || 'about'
  - title = title || 'О нас'
  - variant = variant || 'full'
  - buttonHref = buttonHref || '#'
  - buttonType = buttonType || 'filled'
  section.section.section--about(id=sectionId)
    +Container()
      .about.section_content
        +SectionHeader(title)
        .about_inner
          .about_text
            if variant === 'full'
              p «Центр профессиональной подготовки» основан 3 августа 1998 года.
              p Каждый год выпускниками «Центра профессиональной подготовки» по различным программам, становятся более 8000 человек.
              p Обладая богатейшим опытом в деле подготовки, переподготовки и повышения квалификации частных охранников всех категорий, а так же их руководителей, «Центр профессиональной подготовки» не только ведёт образовательную деятельность, но и оказывает активное содействие сотрудникам ГУВД МО. С начала 2006 года наши специалисты участвуют в обеспечении периодических проверок, проводимых на основании приказов комиссией МВД России и выявляющих профпригодность лиц и организаций, работающих в сфере частной охраны и обладающих возможностью использования в своей деятельности огнестрельного оружия и специальных средств.
            else
              p «Центр профессиональной подготовки» основан 3 августа 1998 года. Каждый год выпускниками по различным программам становятся более 8000 человек. Мы ведём образовательную деятельность и оказываем содействие в проведении периодических проверок.
          .about_img-wrap
            img(src="assets/img/about-us-img.png", alt="Центр профессиональной подготовки", width="760", height="480")
        +SectionFooter(buttonHref, buttonType)
